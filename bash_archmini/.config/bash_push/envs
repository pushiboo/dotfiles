# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi
export STARSHIP_CONFIG=~/.config/starship/starship.toml
# set editor
export EDITOR=nvim
# ssh-agent
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
# Mammouth Code
export PATH="$HOME/.mammouth/bin:$PATH"
# Mongodb
export MONGODB_ADMIN="pushAdmin"
export MONGODB_ADMIN_PASSWORD=$(
  if [[ -f "${HOME}/docker/mongodb/secrets/db_admin_pwd" ]]; then
    cat "${HOME}/docker/mongodb/secrets/db_admin_pwd"
  else
    echo "YouNeedToCheckYourPasswordFile - HINT, see your bash envs!"
  fi
)
export MONGODB_USER="push"
export MONGODB_ROOT_USER="root"
export MONGODB_ROOT_PASSWORD=$(
  if [[ -f "${HOME}/docker/mongodb/secrets/db_root_pwd" ]]; then
    cat "${HOME}/docker/mongodb/secrets/db_root_pwd"
  else
    echo "YouNeedToCheckYourPasswordFile - HINT, see your bash envs!"
  fi
)

# Some website tokens
export VITE_MONGODB_HOST='mongodb.push'
export VITE_MONGODB_PORT='27017'
export VITE_MONGODB_ANDPLIDB='vueWithPinia'
export VITE_MONGODB_ANDPLIADMIN='andreasplichtaAdmin'
export VITE_MONGODB_ANDPLIPWD=$(
