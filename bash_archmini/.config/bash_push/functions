# create your links
# LINK_MOUNTS=(
#   "${HOME}/andreas"
#   "${HOME}/docker"
#   "${HOME}/Pictures/photos_shared"
# )
set_cifs_links() {
  for link in "${LINK_MOUNTS[@]}"; do
    local linkname=$(basename "$link")
    [ ! -L "$link" ] && ln -s "$link" "${HOME}/${linkname}" || echo "Link $link already exists"
  done
}

# Compression
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }
alias decompress="tar -xzf"

# creating a yazi shell wrapper as suggested here: https://yazi-rs.github.io/docs/quick-start/
y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# same as above but with sudo rigths
sy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	sudo -E yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
