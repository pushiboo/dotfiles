# File system
alias ls='eza -lh --group-directories-first --icons=auto'
alias ll='ls -al'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias cd="zd"
alias dot="cd ~/dotfiles"
alias nsl='nslookup'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias d='docker'
alias r='rails'

# Git
alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

# alias p='python'
alias srcbash="source ~/.bashrc"
alias cl=clear
alias vim=nvim
alias vi=nvim
alias svim='sudo -E nvim'
alias sedit='sudo -E EDITOR=vim'
alias dfnfs="df -T -t nfs"
alias dfcifs="df -T -t cifs"
alias dfstat="nfsstat -m"
alias arch="cd /mnt/ds923plus/andreas/arch"
alias andreas="cd /mnt/ds923plus/andreas"
alias syazi='sudo -E yazi'

