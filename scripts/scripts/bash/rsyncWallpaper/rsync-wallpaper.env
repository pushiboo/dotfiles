SRC=/mnt/smb/photos_shared/wallpapers/push-night
DEST=/home/push/dotfiles/omarchy/.config/omarchy/backgrounds/push-night
MIRROR=0                                  # also delete files in DEST that are gone from SRC (default 0)
REQUIRE_MOUNT=/mnt/smb/photos_shared/     # refuse to run if this is not mounted
RSYNC_OPTS="-rt --partial"                # use this for SMB/CIFS targets
