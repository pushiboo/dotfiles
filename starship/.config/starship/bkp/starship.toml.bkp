"$schema" = 'https://starship.rs/config-schema.json'

# push-night color shema
# #9e0059
# #f72585
# #7209b7
# #3a0ca3
# #4361ee
# #4cc9f0
# #06969A
# #ff5400
#
#
# old palette 
# #9A348E
# #DA627D
# #FCA17D
# #86BBD8
# #06969A
# #33658A
#


format = """
[](#9e0059)\
$os\
$username\
[](bg:#7209b7 fg:#9e0059)\
$directory\
[](fg:#7209b7 bg:#3a0ca3)\
$git_branch\
$git_status\
[](fg:#3a0ca3 bg:#4361ee)\
$c\
$elixir\
$elm\
$golang\
$gradle\
$haskell\
$java\
$julia\
$nodejs\
$nim\
$rust\
$scala\
[](fg:#4361ee bg:#4cc9f0)\
$docker_context\
[](fg:#4cc9f0  bg:#06969A)\
$time\
[ ](fg:#06969A)\
"""

# Disable the blank line at the start of the prompt
# add_newline = false

# You can also replace your username with a neat symbol like   or disable this
# and use the os module below
[username]
show_always = true
style_user = "fg:black bg:#9e0059"
style_root = "bg:#9e0059"
format = '[$user ]($style)'
disabled = false

# An alternative to the username module which displays a symbol that
# represents the current operating system
[os]
style = "bg:#9e0059"
disabled = true # Disabled by default

[directory]
style = "bg:#7209b7"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

# Here is how you can shorten some long paths by text replacement
# similar to mapped_locations in Oh My Posh:
[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "
# Keep in mind that the order matters. For example:
# "Important Documents" = " 󰈙 "
# will not be replaced, because "Documents" was already substituted before.
# So either put "Important Documents" before "Documents" or use the substituted version:
# "Important 󰈙 " = " 󰈙 "
[character]
success_symbol = "[λ](bold green)"
error_symbol = "[λ](bold red)"

[c]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[cpp]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[docker_context]
symbol = " "
style = "bg:#4cc9f0"
format = '[ $symbol $context ]($style)'

[elixir]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[elm]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[git_branch]
symbol = ""
style = "bg:#3a0ca3"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:#3a0ca3"
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[gradle]
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[haskell]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[java]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[julia]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[nodejs]
symbol = ""
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[nim]
symbol = "󰆥 "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[rust]
symbol = ""
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[scala]
symbol = " "
style = "bg:#4361ee"
format = '[ $symbol ($version) ]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "fg:black bg:#06969A"
format = '[ λ $time ]($style)'
#format = '[ ♥ $time ]($style)'
