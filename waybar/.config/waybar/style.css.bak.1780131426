/* @import "../omarchy/current/theme/waybar.css"; */
/* @import "/home/push/dotfiles/omarchy/.config/omarchy/current/theme/waybar.css"; */
@import "waybar.css";
* {
  background-color: @background;
  color: @foreground;

  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: 'Mononoki Nerd Font';
  font-size: 12px;
}

.modules-left {
  margin-left: 8px;
}

.modules-right {
  margin-right: 8px;
}

#workspaces button {
  all: initial;
  padding: 0 6px;
  margin: 0 1.5px;
  min-width: 9px;
}

#workspaces button.urgent {
  background-color: @red;
  color: @spotify;
}
#workspaces button.empty {
  opacity: 0.5;
}

#custom-spotify {
  padding: 0 10px;
  margin: 0 4px;
  opacity: 0.8;
/*     color: @foreground; */
  color: @spotify;
}

#custom-omarchy {
  color: @spotify;
}

#tray,
#cpu,
#battery,
#network,
#bluetooth,
#pulseaudio,
#custom-update {
  min-width: 12px;
  margin: 0 7.5px;
}

#custom-expand-icon {
  margin-right: 7px;
}

#tooltip {
  padding: 2px;
}

#custom-update {
  font-size: 10px;
}

#clock {
  margin-left: 8.75px;
}

.hidden {
  opacity: 0;
}

#custom-idle-indicator.active,
#custom-notification-silencing-indicator.active {
  color: #a55555;
}

#custom-weather {
  margin-left: 7.5px;
  margin-right: 7.5px;
}

#custom-weather.unavailable {
  min-width: 0;
  margin: 0;
  padding: 0;
}
