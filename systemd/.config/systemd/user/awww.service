Description=Awww Wallpaper Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/awww-daemon
Restart=on-abnormal

[Install]
WantedBy=graphical-session.target   
