[Unit]
Description=Change hourly timer for the wallpaper with hyprpaper
Wants=changeBackground.timer
After=graphical-session.target
;After=default.target

[Service]
Type=oneshot
ExecStart=/bin/sh %h/scripts/bash/changeBackground/changeBackground.sh

[Install]
WantedBy=graphical-session.target
;WantedBy=graphical-session.target
